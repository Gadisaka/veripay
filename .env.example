# ── Core ─────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Public base URL. Must match the Google OAuth redirect URI exactly.
APP_URL=https://payment.offsetsoftware.net

# ── Database ─────────────────────────────────────────────────────────────────
# Required. Create the database and user in Plesk, then paste the connection
# string here. Run `npm run deploy` once after changing it to apply migrations.

DATABASE_URL="mysql://veripay:password@localhost:3306/veripay"

# ── Sessions ─────────────────────────────────────────────────────────────────
# Signs the dashboard session cookie. Changing it signs everybody out.
# Generate with: openssl rand -hex 32

SESSION_SECRET=

# ── Google sign-in ───────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorized redirect URI:
#   https://payment.offsetsoftware.net/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that receive ADMIN on first signup only.
# Leave empty to auto-admin only the very first account on a fresh database.
# Role changes after that are done in /admin — signing in again will not
# re-promote or demote anyone.
ADMIN_EMAILS=

# ── Optional ─────────────────────────────────────────────────────────────────

# Machine keys for your own internal calls, bypassing the dashboard. These are
# not tied to an account and are not counted against any quota.
VERIPAY_API_KEYS=

# Telebirr proxy fallback for regionally restricted lookups.
TELEBIRR_PROXY_URL=
TELEBIRR_PROXY_KEY=

# Mistral API key for receipt-image OCR (Pixtral). Required for POST /verify-image
# and /admin/image. Image verification is restricted to administrator API keys
# and the admin dashboard — regular user keys receive 403.
MISTRAL_API_KEY=

# Development shortcut that signs in without Google. Ignored in production.
DEV_LOGIN_EMAIL=
