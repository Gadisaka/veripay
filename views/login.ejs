<%- include('partials/header', { title: 'Sign in — Veripay', active: '' }) %>

<div class="container" style="max-width:440px;padding-top:72px;padding-bottom:96px">

  <div class="center stack stack-3" style="margin-bottom:28px">
    <h1 class="h2">Create your API key</h1>
    <p class="muted">
      Sign in with Google to get a key. The service is free — there is nothing to pay for and no card to add.
    </p>
  </div>

  <% if (error) { %>
    <div class="flash flash-error"><%= error %></div>
  <% } %>

  <div class="card stack stack-4">
    <% if (googleConfigured) { %>
      <a class="btn btn-google btn-lg btn-block" href="/auth/google?next=<%= encodeURIComponent(next) %>">
        <svg width="17" height="17" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.6l6.7-6.7C35.6 2.6 30.2 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.8 6.1C12.3 13.2 17.7 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.1 24.6c0-1.6-.1-3.1-.4-4.6H24v9.1h12.4c-.5 2.9-2.2 5.4-4.7 7l7.6 5.9c4.4-4.1 6.8-10.1 6.8-17.4z"/>
          <path fill="#FBBC05" d="M10.4 28.7c-.5-1.4-.8-2.9-.8-4.7s.3-3.3.8-4.7l-7.8-6.1C.9 16.3 0 20 0 24s.9 7.7 2.6 10.8l7.8-6.1z"/>
          <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.8 2.3-8.3 2.3-6.3 0-11.7-3.7-13.6-9.8l-7.8 6.1C6.5 42.6 14.6 48 24 48z"/>
        </svg>
        Continue with Google
      </a>
    <% } else { %>
      <div class="panel-note warn">
        Google sign-in is not configured on this deployment. Set <code class="inline">GOOGLE_CLIENT_ID</code> and
        <code class="inline">GOOGLE_CLIENT_SECRET</code>.
      </div>
    <% } %>

    <% if (devLoginAvailable) { %>
      <a class="btn btn-block" href="/auth/dev-login?next=<%= encodeURIComponent(next) %>">
        Continue as development user
      </a>
      <p class="xs faint center">Development shortcut — disabled when NODE_ENV is production.</p>
    <% } %>
  </div>

  <p class="xs faint center" style="margin-top:20px">
    We store your name, email address and profile picture. Nothing else.
  </p>
</div>

<%- include('partials/footer') %>
