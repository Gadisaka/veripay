        </p>
      </div>

      <div class="card stack stack-3">
        <span class="feature-num">06</span>
        <h3 class="h3">Free, genuinely</h3>
        <p class="muted small">
          No tiers, no image credits, no card. Sign in with Google, create a key, and start verifying
          straight away.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ── providers ─────────────────────────────────────────────────────────── -->

