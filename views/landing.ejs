      <div class="chips">
        <span class="chip"><span class="dot"></span>CBE</span>
        <span class="chip"><span class="dot"></span>Telebirr</span>
        <span class="chip"><span class="dot"></span>Bank of Abyssinia</span>
        <span class="chip"><span class="dot"></span>Dashen</span>
        <span class="chip"><span class="dot"></span>CBE Birr</span>
        <span class="chip"><span class="dot"></span>M-Pesa</span>
