<!-- ── cta ───────────────────────────────────────────────────────────────── -->

<section class="section">
  <div class="container center stack stack-6">
    <div class="stack stack-3">
      <span class="eyebrow">Ready when you are</span>
      <h2 class="h2 measure-center">Verify a payment now, or get the key that handles the next hundred.</h2>
      <p class="lede measure-center">
        Use the widget above for a one-off check, then sign in when you are ready to wire it into your
        application.
      </p>
    </div>
    <div class="row" style="justify-content:center">
      <a class="btn btn-accent btn-lg" href="/login">Continue with Google</a>
      <a class="btn btn-lg" href="/docs">Read the docs</a>
    </div>
  </div>
</section>

<script>
  (function () {
    var runBtn = document.getElementById('v-run');
    var box = document.getElementById('v-result');

    function show(html) {
      box.hidden = false;
      box.innerHTML = html;
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function renderSuccess(payload) {
      var data = payload.data || {};
      var rows = [
        ['Payer', data.payer],
        ['Receiver', data.receiver],
        ['Amount', data.amount],
        ['Date', data.date],
        ['Reference', data.reference]
      ].filter(function (row) { return row[1]; });

      if (rows.length === 0) {
        show('<pre>' + escapeHtml(JSON.stringify(payload.data, null, 2)) + '</pre>');
        return;
      }

      var body = rows.map(function (row) {
        return '<tr><td class="muted">' + row[0] + '</td><td class="mono">' + escapeHtml(row[1]) + '</td></tr>';
      }).join('');

      show(
        '<div class="panel-note good" style="margin-bottom:12px">Payment confirmed' +
        (payload.provider ? ' via <strong>' + escapeHtml(payload.provider) + '</strong>' : '') + '.</div>' +
        '<div class="table-wrap"><table class="data"><tbody>' + body + '</tbody></table></div>'
      );
    }

    runBtn.addEventListener('click', async function () {
      var reference = document.getElementById('v-reference').value.trim();

      if (!reference) {
        show('<div class="panel-note warn">Enter a payment reference first.</div>');
        return;
      }

      runBtn.disabled = true;
      runBtn.textContent = 'Verifying…';
      show('<div class="panel-note">Contacting the provider. Legacy CBE receipts can take up to 30 seconds.</div>');

      try {
        var response = await fetch('/public/verify', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            reference: reference,
            suffix: document.getElementById('v-suffix').value.trim() || undefined,
            phoneNumber: document.getElementById('v-phone').value.trim() || undefined
          })
        });

        var payload = await response.json();

        if (payload.success) {
          renderSuccess(payload);
        } else {
          show('<div class="panel-note danger">' + escapeHtml(payload.error || 'Verification failed.') + '</div>');
        }
      } catch (err) {
        show('<div class="panel-note danger">Could not reach the server. Please try again.</div>');
      } finally {
        runBtn.disabled = false;
        runBtn.textContent = 'Verify payment';
      }
    });
  })();
</script>

