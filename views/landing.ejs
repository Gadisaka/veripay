<%- include('partials/header', { title: 'Veripay — Ethiopian payment verification API', active: 'verify' }) %>

<!-- ── hero ──────────────────────────────────────────────────────────────── -->

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="stack stack-6">
        <span class="badge badge-good" style="align-self:flex-start"><span class="dot"></span>Free forever — no plans, no card</span>

        <h1 class="display">
          Verify<br>payments.
        </h1>

        <p class="lede measure">
          Confirm bank transfers and mobile money receipts from Ethiopian and Kenyan providers with a single
          API call. Send a reference, get structured payment details back.
        </p>

        <div class="row row-wrap">
          <a class="btn btn-accent btn-lg" href="/login">Get your API key</a>
          <a class="btn btn-lg" href="#verify">Verify a payment</a>
          <a class="btn btn-ghost btn-lg" href="/docs">Documentation</a>
        </div>

        <div class="stack stack-3" style="margin-top:8px">
          <span class="eyebrow">Supported providers</span>
          <div class="marquee">
            <div class="marquee-track">
              <% const providers = ['CBE', 'Telebirr', 'Bank of Abyssinia', 'Dashen', 'CBE Birr', 'M-Pesa']; %>
              <% for (let pass = 0; pass < 2; pass++) { %>
                <% providers.forEach(function (name) { %>
                  <span class="chip"><span class="dot"></span><%= name %></span>
                <% }); %>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- verification widget -->
      <div class="card card-flush" id="verify" style="box-shadow:var(--shadow)">
        <div class="card-head">
          <span class="card-title">Try it now</span>
          <span class="badge"><%= publicChecksPerHour %> free checks per hour</span>
        </div>

        <div class="card-body stack stack-4">
          <label class="field">
            <span class="label">Payment reference or receipt link</span>
            <input type="text" id="v-reference" autocomplete="off"
                   placeholder="FT25123ABCD, a Telebirr receipt number, or a CBE link">
          </label>

          <div class="grid grid-2" style="gap:12px">
            <label class="field">
              <span class="label">Account suffix <span class="faint">optional</span></span>
              <input type="text" id="v-suffix" maxlength="8" placeholder="Last 8 digits" autocomplete="off">
            </label>
            <label class="field">
              <span class="label">Phone number <span class="faint">optional</span></span>
              <input type="text" id="v-phone" placeholder="2519…" autocomplete="off">
            </label>
          </div>

          <button class="btn btn-accent btn-block btn-lg" id="v-run">Verify payment</button>

          <div id="v-result" hidden></div>

          <p class="hint center">
            No sign-in needed for a quick check.
            <a href="/login" style="color:var(--accent)">Create a free key</a> for unlimited use in your app.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── integration ───────────────────────────────────────────────────────── -->

<section class="section-tight">
  <div class="container">
    <div class="hero-grid" style="align-items:center">
      <div class="stack stack-4">
        <span class="eyebrow">Frontend or backend</span>
        <h2 class="h2">Verify from your app in one call.</h2>
        <p class="lede measure">
          One endpoint accepts every supported provider. The smart router reads the reference format and
          picks the right adapter, so you do not have to ask the buyer which bank they used.
        </p>
        <div class="row row-wrap">
          <a class="btn" href="/docs#smart-router">How routing works</a>
          <a class="btn btn-ghost" href="/docs#endpoints">All endpoints</a>
        </div>
      </div>

      <div class="window">
        <div class="window-bar">
          <span class="window-dots"><i></i><i></i><i></i></span>
          <span>verify-payment.ts</span>
        </div>
<pre><code><span class="tok-key">const</span> endpoint = <span class="tok-str">'<%= appUrl %>/verify'</span>;

<span class="tok-key">const</span> response = <span class="tok-key">await</span> <span class="tok-fn">fetch</span>(endpoint, {
  method: <span class="tok-str">'POST'</span>,
  headers: {
    <span class="tok-str">'content-type'</span>: <span class="tok-str">'application/json'</span>,
    <span class="tok-str">'x-veripay-key'</span>: process.env.<span class="tok-key">VERIPAY_KEY</span>,
  },
  body: <span class="tok-fn">JSON</span>.stringify({
    reference: input.reference,
    suffix: input.suffix,
  }),
});

<span class="tok-key">const</span> result = <span class="tok-key">await</span> response.<span class="tok-fn">json</span>();
<span class="tok-key">if</span> (!result.success) <span class="tok-key">throw new</span> <span class="tok-fn">Error</span>(result.error);

<span class="tok-com">// { payer, receiver, amount, date, reference }</span>
<span class="tok-key">return</span> result.data;</code></pre>
      </div>
    </div>
  </div>
</section>

<!-- ── services ──────────────────────────────────────────────────────────── -->

