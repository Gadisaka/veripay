<%- include('../partials/header', { title: title, active: active }) %>

<div class="app-shell">
  <%- include('../partials/appnav', { section: section }) %>

  <main class="app-main">
    <div class="page-head">
      <h1 class="page-title">Account</h1>
    </div>

    <div class="grid grid-2" style="align-items:start">
      <div class="card card-flush">
        <div class="card-head"><span class="card-title">Profile</span></div>
        <div class="card-body stack stack-3">
          <div class="row" style="gap:14px">
            <% if (user.avatarUrl) { %>
              <img src="<%= user.avatarUrl %>" alt="" width="44" height="44" style="border-radius:50%">
            <% } %>
            <div>
              <div style="font-weight:600"><%= user.name || 'Unnamed' %></div>
              <div class="small muted"><%= user.email %></div>
            </div>
          </div>
          <div class="row row-wrap" style="gap:8px">
            <span class="badge <%= user.role === 'ADMIN' ? 'badge-info' : '' %>"><%= user.role %></span>
            <span class="badge badge-good"><span class="dot"></span><%= user.status %></span>
            <span class="badge">Joined <%= user.createdAt.toISOString().slice(0, 10) %></span>
          </div>
        </div>
      </div>

      <div class="card card-flush">
        <div class="card-head"><span class="card-title">Limits</span></div>
        <div class="card-body stack stack-3">
          <div class="row row-between">
            <span class="muted small">Monthly verifications</span>
            <span class="mono small"><%= quota.limit > 0 ? quota.used + ' / ' + quota.limit : 'unlimited' %></span>
          </div>
          <div class="row row-between">
            <span class="muted small">Requests per minute</span>
            <span class="mono small"><%= rateLimit %></span>
          </div>
          <div class="row row-between">
            <span class="muted small">Quota resets</span>
            <span class="mono small"><%= quota.resetsAt.toISOString().slice(0, 10) %></span>
          </div>
          <p class="hint">Need more? The service is free — ask the administrator to raise your limits.</p>
        </div>
      </div>
    </div>

    <div class="card card-flush" style="margin-top:20px;border-color:#3a2029">
      <div class="card-head"><span class="card-title" style="color:var(--danger)">Delete account</span></div>
      <div class="card-body stack stack-3">
        <p class="small muted">
          Removes your account, every API key you created and your usage history. Applications using your
          keys will stop working immediately. This cannot be undone.
        </p>
        <form method="post" action="/dashboard/settings/delete"
              onsubmit="return confirm('Delete your account and revoke all keys? This cannot be undone.')">
          <button class="btn btn-danger" type="submit">Delete my account</button>
        </form>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
